[Unit]
Description=Atuistas
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# Las rutas las sustituye deploy/setup-servicio.sh al instalar el servicio.
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/app.js
Restart=always
RestartSec=5

# La app solo necesita escribir en uploads/ y en data/ (claves de Push).
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
