[Unit]
Description=Atuistas
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=atuistas
Group=atuistas
WorkingDirectory=/opt/atuistas
EnvironmentFile=/opt/atuistas/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/app.js
Restart=always
RestartSec=5

# El proceso solo necesita leer su propio codigo y escribir en uploads/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/atuistas/uploads /opt/atuistas/data

[Install]
WantedBy=multi-user.target
